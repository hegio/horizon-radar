{
  "ai": {
    "provider": "openai",
    "model": "qwen3.8-flash-next-iq2_xs",
    "api_key_env": "HORIZON_AI_KEY",
    "base_url": "http://127.0.0.1:8080/v1",
    "languages": [
      "zh"
    ],
    "temperature": 0.3,
    "max_tokens": 32768,
    "throttle_sec": 0,
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "world-news",
    "profile_settings": {
      "world-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "tech-news": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "collection": {
    "time_window_hours": 24
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100,
      "category": "tech",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Google News 香港",
        "url": "https://news.google.com/rss/search?q=%E9%A6%99%E6%B8%AF&hl=zh-HK&gl=HK&ceid=HK%3Azh-Hant",
        "enabled": true,
        "category": "hk-news",
        "profile": "world-news"
      },
      {
        "name": "明报",
        "url": "https://news.mingpao.com/rss/pns/s00001.xml",
        "enabled": true,
        "category": "hk-news",
        "profile": "world-news"
      },
      {
        "name": "HKFP",
        "url": "https://hongkongfp.com/feed/",
        "enabled": true,
        "category": "hk-news",
        "profile": "world-news"
      },
      {
        "name": "Google News 中国",
        "url": "https://news.google.com/rss/search?q=%E4%B8%AD%E5%9B%BD&hl=zh-CN&gl=CN&ceid=CN%3Azh-Hans",
        "enabled": true,
        "category": "cn-news",
        "profile": "world-news"
      },
      {
        "name": "德国之声中文",
        "url": "https://rss.dw.com/rdf/rss-chi-all",
        "enabled": true,
        "category": "cn-news",
        "profile": "world-news"
      },
      {
        "name": "BBC World",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "intl-news",
        "profile": "world-news"
      },
      {
        "name": "NYT World",
        "url": "https://rss.nytimes.com/services/xml/rss/nyt/World.xml",
        "enabled": true,
        "category": "intl-news",
        "profile": "world-news"
      },
      {
        "name": "Google News AI",
        "url": "https://news.google.com/rss/search?q=artificial+intelligence&hl=en-US&gl=US&ceid=US%3Aen",
        "enabled": true,
        "category": "ai-news",
        "profile": "tech-news"
      },
      {
        "name": "HuggingFace Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-news",
        "profile": "tech-news"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog"
      },
      {
        "name": "Ars Technica",
        "url": "https://feeds.arstechnica.com/arstechnica/index",
        "enabled": true,
        "category": "tech",
        "profile": "tech-news"
      },
      {
        "name": "IT之家",
        "url": "https://www.ithome.com/rss/",
        "enabled": true,
        "category": "cn-tech",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "fetch_comments": 5,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "ai-news",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10,
          "min_score": 10,
          "category": "ai-news",
          "profile": "tech-news"
        },
        {
          "subreddit": "worldnews",
          "enabled": true,
          "sort": "hot",
          "fetch_limit": 10,
          "min_score": 100,
          "category": "intl-news",
          "profile": "world-news"
        },
        {
          "subreddit": "China_irl",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10,
          "min_score": 10,
          "category": "cn-news",
          "profile": "world-news"
        },
        {
          "subreddit": "HongKong",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10,
          "min_score": 10,
          "category": "hk-news",
          "profile": "world-news"
        }
      ],
      "users": []
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "category": "ai-news",
          "profile": "tech-news"
        }
      ]
    },
    "github": [
      {
        "type": "repo_releases",
        "owner": "ollama",
        "repo": "ollama",
        "enabled": true,
        "category": "oss",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "oss",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "openclaw",
        "repo": "openclaw",
        "enabled": true,
        "category": "oss",
        "profile": "tech-news"
      }
    ],
    "ossinsight": {
      "enabled": false
    },
    "gdelt": {
      "enabled": true,
      "query": "(china OR taiwan OR \"hong kong\") sourcelang:chinese",
      "mode": "ArtList",
      "max_records": 50,
      "category": "cn-news",
      "profile": "world-news"
    },
    "twitter": {
      "enabled": false
    },
    "google_news": {
      "enabled": false
    },
    "openbb": {
      "enabled": false
    }
  },
  "digest": {
    "max_items": 30,
    "profile_order": [
      "world-news",
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {
      "hk": {
        "name": "香港",
        "limit": 5,
        "categories": [
          "hk-news"
        ]
      },
      "cn": {
        "name": "中国",
        "limit": 6,
        "categories": [
          "cn-news"
        ]
      },
      "us_intl": {
        "name": "美国/国际",
        "limit": 7,
        "categories": [
          "us-news",
          "intl-news"
        ]
      },
      "ai": {
        "name": "AI/科技",
        "limit": 8,
        "categories": [
          "ai-news",
          "ai-tools",
          "llm-inference",
          "tech",
          "cn-tech",
          "oss",
          "oss-trending"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 4
  },
  "wechat": {
    "enabled": false
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "chat_id": "5493574923",
      "text": "#{message_title}\n\n#{summary?limit=3800}"
    },
    "headers": ""
  }
}
